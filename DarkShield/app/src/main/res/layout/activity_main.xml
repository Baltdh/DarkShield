<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#090B10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Ícone de proteção DarkShield"
                android:src="@drawable/ic_shield" />

            <TextView
                android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="DarkShield"
            android:text="DarkShield"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginStart="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Proteção e auditoria local do Android"
            android:textColor="#AEB4C2"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROTEÇÃO DO DISPOSITIVO"
                android:textColor="#8F97A8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="PRONTO PARA VERIFICAR"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Verificação local, sem remoção automática de aplicativos."
                android:textColor="#B8BECC"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/last_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Nenhuma verificação executada nesta sessão"
                android:textColor="#7F8797"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/next_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:background="@drawable/bg_report"
            android:text="Aguarde enquanto o DarkShield analisa o dispositivo."
            android:textColor="#B8BECC"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/count_critical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="8dp"
                android:text="CRÍTICO\n0"
                android:textColor="#FF6B6B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_report" />

            <TextView
                android:id="@+id/count_high"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="ALTO\n0"
                android:textColor="#FFC857"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_report" />

            <TextView
                android:id="@+id/count_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="MÉDIO\n0"
                android:textColor="#B8BECC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_report" />

            <TextView
                android:id="@+id/count_low"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="BAIXO\n0"
                android:textColor="#66E3A4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_report" />
        </LinearLayout>

        <Button
            android:id="@+id/scan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Iniciar verificação completa"
            android:text="VERIFICAR AGORA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="ABRIR CONFIGURAÇÕES DE SEGURANÇA"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/share"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="COMPARTILHAR"
                android:textSize="12sp" />

            <Button
                android:id="@+id/copy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="COPIAR"
                android:textSize="12sp"
                android:contentDescription="Copiar relatório de segurança" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="RESULTADOS DA VERIFICAÇÃO"
            android:textColor="#8F97A8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="16dp"
            android:background="@drawable/bg_report"
            android:textColor="#D9DDE7"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Dica: toque em um pacote listado para abrir os detalhes do aplicativo. Indicadores são analisados em conjunto; um sinal isolado não confirma malware."
            android:textColor="#7F8797"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>